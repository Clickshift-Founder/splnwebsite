# ── Database ─────────────────────────────────────────────
# Production: Neon Postgres (Vercel Marketplace → Neon). Any Postgres URL works (e.g. Supabase).
# Leave empty locally to use the PGlite server started by `npm run db:dev` (127.0.0.1:54329).
DATABASE_URL=

# ── Auth ─────────────────────────────────────────────────
# Long random string (openssl rand -base64 48). Signs admin + member session cookies.
AUTH_SECRET=
# First super-admin. Created automatically on the first deploy (only once — later password
# changes happen in /admin → Admins & security and are never reset by a deploy).
ADMIN_NAME="SPLN Director"
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Email (one-time codes for graduates editing their profiles) ──
# https://resend.com — without a key, codes are printed to the server console (dev only).
RESEND_API_KEY=
EMAIL_FROM="SPLN <no-reply@pln.thesppg.org>"

# ── File uploads ─────────────────────────────────────────
# Vercel Blob (Storage → Blob, Public). On Vercel a connected store needs no token (OIDC). Locally: paste a
# read-write token to test real uploads; leave empty and uploads go to public/uploads (dev only).
BLOB_READ_WRITE_TOKEN=

# ── Site ─────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
